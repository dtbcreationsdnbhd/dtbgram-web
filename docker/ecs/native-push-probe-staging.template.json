{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Temporary single-device native push probe on staging; contains no secret values",
  "Parameters": {
    "VpcId": {
      "Type": "AWS::EC2::VPC::Id"
    },
    "SubnetIds": {
      "Type": "List<AWS::EC2::Subnet::Id>"
    },
    "LoadBalancerSecurityGroupId": {
      "Type": "AWS::EC2::SecurityGroup::Id"
    },
    "HttpsListenerArn": {
      "Type": "String",
      "AllowedPattern": "arn:aws:elasticloadbalancing:ap-southeast-1:277715911124:listener/app/.+"
    },
    "ListenerPriority": {
      "Type": "Number",
      "MinValue": 1,
      "MaxValue": 50000
    },
    "AssignPublicIp": {
      "Type": "String",
      "AllowedValues": [
        "ENABLED",
        "DISABLED"
      ]
    },
    "ImageTag": {
      "Type": "String",
      "Default": "bootstrap",
      "AllowedPattern": "[a-z0-9][a-z0-9._-]{0,127}"
    },
    "DesiredCount": {
      "Type": "Number",
      "AllowedValues": [
        0,
        1
      ],
      "Default": 0
    }
  },
  "Resources": {
    "Repository": {
      "Type": "AWS::ECR::Repository",
      "Properties": {
        "RepositoryName": "dtbgram-native-push-probe-staging",
        "ImageTagMutability": "IMMUTABLE",
        "EmptyOnDelete": true,
        "EncryptionConfiguration": {
          "EncryptionType": "AES256"
        }
      }
    },
    "ProbeSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "Name": "dtbgram/native-push-probe/staging/config",
        "Description": "One-hour native probe configuration; operator writes value out of band"
      }
    },
    "FirebaseSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "Name": "dtbgram/native-push-probe/staging/firebase",
        "Description": "Firebase sender credentials for the controlled staging probe"
      }
    },
    "LogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/ecs/dtbgram-native-push-probe-staging",
        "RetentionInDays": 1
      }
    },
    "ExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "PullProbeImageAndSecrets",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "ecr:GetAuthorizationToken",
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchCheckLayerAvailability",
                    "ecr:GetDownloadUrlForLayer",
                    "ecr:BatchGetImage"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Repository",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "LogGroup",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "secretsmanager:GetSecretValue",
                  "Resource": [
                    {
                      "Ref": "ProbeSecret"
                    },
                    {
                      "Ref": "FirebaseSecret"
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "ProbeSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Native probe ingress only from the existing staging ALB",
        "VpcId": {
          "Ref": "VpcId"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 8787,
            "ToPort": 8787,
            "SourceSecurityGroupId": {
              "Ref": "LoadBalancerSecurityGroupId"
            }
          }
        ],
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0"
          }
        ]
      }
    },
    "LoadBalancerProbeEgress": {
      "Type": "AWS::EC2::SecurityGroupEgress",
      "Properties": {
        "GroupId": {
          "Ref": "LoadBalancerSecurityGroupId"
        },
        "IpProtocol": "tcp",
        "FromPort": 8787,
        "ToPort": 8787,
        "DestinationSecurityGroupId": {
          "Ref": "ProbeSecurityGroup"
        },
        "Description": "Temporary HTTPS native probe target"
      }
    },
    "TargetGroup": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "Protocol": "HTTP",
        "Port": 8787,
        "TargetType": "ip",
        "VpcId": {
          "Ref": "VpcId"
        },
        "HealthCheckPath": "/health",
        "HealthCheckIntervalSeconds": 10,
        "HealthCheckTimeoutSeconds": 5,
        "HealthyThresholdCount": 2,
        "UnhealthyThresholdCount": 2,
        "Matcher": {
          "HttpCode": "200"
        },
        "TargetGroupAttributes": [
          {
            "Key": "deregistration_delay.timeout_seconds",
            "Value": "0"
          }
        ]
      }
    },
    "ListenerRule": {
      "Type": "AWS::ElasticLoadBalancingV2::ListenerRule",
      "Properties": {
        "ListenerArn": {
          "Ref": "HttpsListenerArn"
        },
        "Priority": {
          "Ref": "ListenerPriority"
        },
        "Conditions": [
          {
            "Field": "host-header",
            "HostHeaderConfig": {
              "Values": [
                "monoverse.biz"
              ]
            }
          },
          {
            "Field": "path-pattern",
            "PathPatternConfig": {
              "Values": [
                "/telegram-push/*"
              ]
            }
          }
        ],
        "Actions": [
          {
            "Type": "forward",
            "TargetGroupArn": {
              "Ref": "TargetGroup"
            }
          }
        ]
      }
    },
    "TaskDefinition": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Family": "dtbgram-native-push-probe-staging",
        "Cpu": "256",
        "Memory": "512",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "RuntimePlatform": {
          "CpuArchitecture": "X86_64",
          "OperatingSystemFamily": "LINUX"
        },
        "ContainerDefinitions": [
          {
            "Name": "native-push-probe",
            "Image": {
              "Fn::Sub": "${Repository.RepositoryUri}:${ImageTag}"
            },
            "Essential": true,
            "Command": [
              "node",
              "main.ts",
              "serve-env"
            ],
            "PortMappings": [
              {
                "ContainerPort": 8787,
                "Protocol": "tcp"
              }
            ],
            "Environment": [
              {
                "Name": "ENABLE_NATIVE_PUSH_PROBE",
                "Value": "1"
              },
              {
                "Name": "NATIVE_PUSH_HOST",
                "Value": "0.0.0.0"
              },
              {
                "Name": "NATIVE_PUSH_PORT",
                "Value": "8787"
              }
            ],
            "Secrets": [
              {
                "Name": "NATIVE_PUSH_PROBE_JSON",
                "ValueFrom": {
                  "Ref": "ProbeSecret"
                }
              },
              {
                "Name": "FIREBASE_SERVICE_ACCOUNT_JSON",
                "ValueFrom": {
                  "Ref": "FirebaseSecret"
                }
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "LogGroup"
                },
                "awslogs-region": "ap-southeast-1",
                "awslogs-stream-prefix": "probe"
              }
            },
            "HealthCheck": {
              "Command": [
                "CMD",
                "node",
                "--input-type=module",
                "-e",
                "fetch('http://127.0.0.1:8787/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
              ],
              "Interval": 10,
              "Timeout": 5,
              "Retries": 3,
              "StartPeriod": 15
            }
          }
        ]
      }
    },
    "Service": {
      "Type": "AWS::ECS::Service",
      "DependsOn": [
        "ListenerRule",
        "LoadBalancerProbeEgress"
      ],
      "Properties": {
        "Cluster": "dtbgram",
        "ServiceName": "dtbgram-native-push-probe-staging",
        "LaunchType": "FARGATE",
        "PlatformVersion": "1.4.0",
        "DesiredCount": {
          "Ref": "DesiredCount"
        },
        "TaskDefinition": {
          "Ref": "TaskDefinition"
        },
        "DeploymentConfiguration": {
          "MinimumHealthyPercent": 0,
          "MaximumPercent": 100,
          "DeploymentCircuitBreaker": {
            "Enable": true,
            "Rollback": true
          }
        },
        "HealthCheckGracePeriodSeconds": 30,
        "LoadBalancers": [
          {
            "ContainerName": "native-push-probe",
            "ContainerPort": 8787,
            "TargetGroupArn": {
              "Ref": "TargetGroup"
            }
          }
        ],
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": {
              "Ref": "AssignPublicIp"
            },
            "Subnets": {
              "Ref": "SubnetIds"
            },
            "SecurityGroups": [
              {
                "Ref": "ProbeSecurityGroup"
              }
            ]
          }
        }
      }
    }
  },
  "Outputs": {
    "RepositoryUri": {
      "Value": {
        "Fn::GetAtt": [
          "Repository",
          "RepositoryUri"
        ]
      }
    },
    "ProbeSecretArn": {
      "Value": {
        "Ref": "ProbeSecret"
      }
    },
    "FirebaseSecretArn": {
      "Value": {
        "Ref": "FirebaseSecret"
      }
    },
    "ServiceName": {
      "Value": {
        "Fn::GetAtt": [
          "Service",
          "Name"
        ]
      }
    },
    "ListenerRuleArn": {
      "Value": {
        "Ref": "ListenerRule"
      }
    },
    "ListenerPriority": {
      "Value": {
        "Ref": "ListenerPriority"
      }
    },
    "TargetGroupArn": {
      "Value": {
        "Ref": "TargetGroup"
      }
    }
  }
}
