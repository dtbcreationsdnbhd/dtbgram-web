NODE_ENV=development

TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Public origin of this build (trailing slash). For the staff-only host, set this to the
# new domain — e.g. https://chat.example.internal/ — and do not 301 the old public domain to it.
BASE_URL=https://web.telegram.org/a/

# Local dev: Vite proxies /platform-api to this origin.
# Production ECS build: set as build-arg (no trailing slash).
PLATFORM_API_ORIGIN=https://main.dhfko7aevmlgq.amplifyapp.com
PLATFORM_API_KEY_WEBSITE=
